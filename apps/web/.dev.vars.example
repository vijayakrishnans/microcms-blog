# Local Worker secrets for `wrangler dev` / `pnpm preview` (opennextjs-cloudflare
# preview). Copy to .dev.vars (git-ignored). On stage and prod they are the
# product's Orun secrets MICROCMS_SERVICE_DOMAIN and MICROCMS_API_KEY, which the
# deploy pushes to the Worker (tooling/wire/worker-secrets.mjs). Both optional:
# without them the blog renders its sample posts.
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
